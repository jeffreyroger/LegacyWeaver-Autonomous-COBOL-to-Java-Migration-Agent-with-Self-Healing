# Harness run artefacts
runs/
*.report.json

# CLI default `weaver verify --report` output (regenerated per run, never a golden fixture)
/report.json
/report_*.json

# Generated run artefacts (regenerated by weaver runs). Exemptions below are
# deterministic default fixtures RunSpec.default() / tests depend on existing
# on disk (regenerate with `python -m weaver.agent.scaffold`), plus the
# hand-authored defect-injection bodies from weaver/agent/seed_memory.py.
generated/*
!generated/Scaffold.java
!generated/o3_case_a_body.java
!generated/o3_case_b_body.java
!generated/o3_case_c_body.java
!generated/o3_case_d_body.java
!generated/taxcalc/
generated/taxcalc/*
!generated/taxcalc/Scaffold.java
!generated/tieraccum/
generated/tieraccum/*
!generated/tieraccum/Scaffold.java
!generated/compound/
generated/compound/*
!generated/compound/Scaffold.java
!generated/shipcost/
generated/shipcost/*
!generated/shipcost/Scaffold.java

# Claude Code worktrees must never be committed as gitlinks (see git history 788956d)
.claude/worktrees/

# OS
.DS_Store
Thumbs.db

# Java class files
*.class
**/build/

# Frontend (Vite + React) -- built into backend/static by `npm run build`
frontend/node_modules/
frontend/dist/
backend/static/*
!backend/static/.gitkeep

